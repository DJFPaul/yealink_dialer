{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YDialer",
  "version": "1.0.0",
  "identifier": "com.yealink.ydialer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:15180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "شماره‌گیر یالینک",
        "width": 420,
        "height": 760,
        "minWidth": 380,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#102126"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "YDialer",
    "category": "Utility",
    "shortDescription": "شماره‌گیر تلفن یالینک",
    "longDescription": "شماره‌گیر دسکتاپ برای تلفن‌های SIP یالینک. تماس روی خود تلفن برقرار می‌شود.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Farsi", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "customLanguageFiles": {
          "Farsi": "./nsis/Farsi.nsh"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tel", "callto", "sip", "phone"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMUVCMjEzRjQyQjlDRTEKUldUaG5DdjBFN0llTWRSYXJqL2Nrb0hOa1o0Uks5TnBDN0hENTAyb0RyN09QVTlWWkw1Q0lRUHgK",
      "endpoints": ["https://updates.invalid/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
